<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MyFakeGPS 漫步導航版"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"/>

        <!-- 捷徑按鈕區 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnOpenDevSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="選取模擬位置設定"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnOpenAppInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="應用程式電池用量"
                android:textSize="11sp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- 主開關區：模擬定位開關 vs 漫步開關 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnToggleMock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶ 開啟模擬定位"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnToggleWander"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎲 開始隨機漫步"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- 速度控制區 (Slider + Text) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="漫步速度 (km/h): "
                android:textSize="13sp"/>

            <SeekBar
                android:id="@+id/seekSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="50"
                android:progress="5"/>

            <EditText
                android:id="@+id/editSpeed"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="5"
                android:inputType="number"
                android:gravity="center"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- 搜尋輸入框 -->
        <EditText
            android:id="@+id/editSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="輸入 Plus Code、地名 或 經緯度"
            android:inputType="textMultiLine"
            android:selectAllOnFocus="true"
            android:lines="2"/>

        <!-- 貼上、定點傳送、導航按鈕 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btnPaste"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 貼上"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnSetLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 傳送至輸入點"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnNavToSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🧭 導航至輸入點"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- 我的最愛區 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★ 我的最愛 (點擊傳送，長按從剪貼簿儲存):"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="2dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFav1"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:textSize="10sp"
                android:padding="0dp"
                android:layout_marginEnd="2dp"/>

            <Button
                android:id="@+id/btnFav2"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:textSize="10sp"
                android:padding="0dp"
                android:layout_marginEnd="2dp"/>

            <Button
                android:id="@+id/btnFav3"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:textSize="10sp"
                android:padding="0dp"
                android:layout_marginEnd="2dp"/>

            <Button
                android:id="@+id/btnFav4"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:textSize="10sp"
                android:padding="0dp"/>
        </LinearLayout>

        <!-- 微調控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手動微調 (公尺): "
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/editDistance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1"
                android:inputType="numberDecimal"
                android:gravity="center"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- 十字方向盤 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btnNorth"
                android:layout_width="60dp"
                android:layout_height="36dp"
                android:text="北 ▲"
                android:padding="0dp"
                android:textSize="11sp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnWest"
                    android:layout_width="60dp"
                    android:layout_height="36dp"
                    android:text="◄ 西"
                    android:padding="0dp"
                    android:textSize="11sp"
                    android:layout_marginEnd="16dp"/>

                <Button
                    android:id="@+id/btnEast"
                    android:layout_width="60dp"
                    android:layout_height="36dp"
                    android:text="東 ►"
                    android:padding="0dp"
                    android:textSize="11sp"
                    android:layout_marginStart="16dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnSouth"
                android:layout_width="60dp"
                android:layout_height="36dp"
                android:text="▼ 南"
                android:padding="0dp"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="狀態：已關閉模擬定位"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="6dp"/>

        <!-- 模式三：地圖點擊選點欄位 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/textMapSelected"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="地圖點擊選點：點擊地圖設置標記"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/btnNavToMapTap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚩 導航至地圖點"
                android:textSize="11sp"
                android:enabled="false"/>
        </LinearLayout>

        <!-- OpenStreetMap 地圖 -->
        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="6dp"/>

    </LinearLayout>
</ScrollView>
